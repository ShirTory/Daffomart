rules_version = '2';
// DaffoMart Firestore security rules.
// Paste into: Firebase Console -> Firestore Database -> Rules -> Publish.
// IMPORTANT: use these only in a NEW Firebase project made for this static site.
// There is no server here, so some checks (like the stock count) can only be "best effort". See README.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // admins/<uid> documents are created by hand in the console. Nobody can create them from the website.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // customers may only LOWER the stock number (this happens when they place an order)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    && request.resource.data.stock is int
                    && request.resource.data.stock >= 0
                    && request.resource.data.stock < resource.data.stock;
    }

    match /coupons/{code} {
      allow get: if true;          // needed to check a code; the list of all codes stays private
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    // customers may only add 1 to the "used" counter
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                        && request.resource.data.usedCount == resource.data.usedCount + 1);
    }

    match /orders/{key} {
      // The document id is a secret (hash of order number + phone), so "get" is open to whoever knows it.
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.paymentMethod == 'cod'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 100
                    && request.resource.data.phone.matches('^01[3-9][0-9]{8}$')
                    && request.resource.data.address is string
                    && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 300
                    && request.resource.data.total is number && request.resource.data.total >= 0
                    && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /applications/{phone} {
      allow create: if request.resource.data.phone == phone
                    && phone.matches('^01[3-9][0-9]{8}$')
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100;
      allow read, update, delete: if isAdmin();
    }
  }
}
