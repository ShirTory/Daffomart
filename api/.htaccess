# Send every /api/... address to index.php (needs mod_rewrite, which almost every host has)
RewriteEngine On

# keep Authorization header (some hosts drop it)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# never let people download these
<FilesMatch "^(config\.php|schema\.sql)$">
  Require all denied
</FilesMatch>
